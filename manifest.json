{
  "manifest_version": 3,
  "name": "Scamometer — AI Phishing & Scam Detector",
  "version": "4.1.0",
  "description": "Analyze websites for phishing and scam signals using optional AI providers, DNS and RDAP, with user-controlled scanning and local reports.",
  "author": "Arnab Mandal",
  "homepage_url": "https://github.com/vio137/scamometer",
  "action": {
    "default_title": "Scamometer",
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://dns.google/*",
    "https://cloudflare-dns.com/*",
    "https://rdap.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.cerebras.ai/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "html/options.html"
}
